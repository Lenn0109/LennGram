# LennGram environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL (no trailing slash)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe to expose in client bundle
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared admin password for /admin/login
ADMIN_PASSWORD=MyMinji@123

# Random 32+ char secret mixed with visitor IP before hashing (likes/views).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIKES_SALT=change-me-to-random-32-chars

# HMAC secret used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-to-random-32-chars

# Public site URL used for OG meta, sitemap, and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
